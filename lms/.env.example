# Kopieren nach .env und anpassen
# Synology: /volume1/docker/lms | QNAP: /share/Container/lms | Pi: /srv/docker/lms
LMS_CONFIG=/srv/docker/lms
# Enthält die Unterordner music/ und playlists/
MEDIA=/srv/media
# 9000 gehört in diesem Setup der step-ca; LMS läuft deshalb auf 9002
LMS_HTTP_PORT=9002
PUID=1000
PGID=1000
TZ=Europe/Zurich
