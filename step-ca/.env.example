# Kopieren nach .env und anpassen
CA_NAME=Home-CA
# Muss den Namen enthalten, den Clients verwenden (DNS-Eintrag auf den Container-Host anlegen)
CA_DNS_NAMES=ca.example.lan,localhost,192.168.1.20
CA_PORT=9000
# Synology: /volume1/docker/step-ca | QNAP: /share/Container/step-ca | Pi: /srv/docker/step-ca
STEP_DATA=/srv/docker/step-ca
